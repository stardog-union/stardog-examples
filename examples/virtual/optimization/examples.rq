# Unique Keys

PREFIX : <urn:>
SELECT * FROM <virtual://uniques> {
    ?s rdfs:label ?label ;
       :yearFormed ?yearFormed .
}

# Foreign Keys and Inclusion Dependencies

PREFIX : <urn:>
SELECT * FROM <virtual://fk_example> {
    ?album a :Album ;
       rdfs:label ?title ;
       :band ?band .
    # Including :Band adds a join unless an Albums.band_id->Bands.id fk exists
    ?band a :Band .
    # Including rdfs:label adds the join despite foreign.key.sets
    # ?band rdfs:label ?name .
}

# Denormalized Data - version 1

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized1> {
    ?s a :Actor ;
       rdfs:label ?name .
}

# Denormalized Data - version 2

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized2> {
    [] a :Role ;
        :actor ?actor ;
        :creditedAs ?name .
}

# Denormalized Data - query over an Actors view

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized2> {
    ?s a :Actor ;
       rdfs:label ?name .
}

# Renormalizing by Aggregated Name

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized3> {
    ?s a :Actor ;
       rdfs:label ?name .
}

# Including Movie details in a Role query (declare functional.dependency.sets in the properties file to remove the self-joins)

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized2> {
    ?role :movie ?movie ;
          :character ?char_name .
    ?movie rdfs:label ?title ;
           :releaseYear ?year .
}

# Movies-only query (declare functional.dependency.sets in the properties file for a single scan)

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized2> {
    ?movie rdfs:label ?title ;
           :releaseYear ?year .
}

# Querying a deduplicated Movies view (requires functional.dependency.sets in the properties file)

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized5> {
    ?movie rdfs:label ?title ;
           :releaseYear ?year .
}

# Combining Movie and Roles (requires functional.dependency.sets in the properties file)

PREFIX : <urn:>
SELECT * FROM <virtual://denormalized5> {
    ?role :movie ?movie ;
          :character ?char_name .
    ?movie rdfs:label ?title ;
           :releaseYear ?year .
}

# Map rdf:type Conservatively

PREFIX : <urn:>
SELECT * FROM <virtual://actors1> {
    ?s a :Actor
}

PREFIX : <urn:>
SELECT * FROM <virtual://actors2> {
    ?s a :Actor
}

# Unique Predicates

PREFIX : <urn:>
SELECT * {
    GRAPH <virtual://predicates> {
        ?s rdfs:label "Tom Hanks"
    }
}

PREFIX : <urn:>
SELECT * {
    GRAPH <virtual://predicates> {
        ?s :name "Tom Hanks"
    }
}

# Mutually Exclusive Templates

PREFIX : <urn:>
SELECT * {
    GRAPH <virtual://templates> {
        ?s a :Actor .
        ?s rdfs:label "Tom Hanks" .
    }
}

# SQL Functions and Query Outputs

PREFIX : <urn:>
SELECT * FROM <virtual://remakes> {
    :movie:5
        :title ?title ;
        :releaseYear ?year ;
        rdfs:label ?label .
}

PREFIX : <urn:>
SELECT * FROM <virtual://remakes> {
    ?movie a :Movie ;
        :title "A Star is Born" ;
        :releaseYear 2018 ;
        rdfs:label ?label .
}

PREFIX : <urn:>
SELECT * FROM <virtual://remakes> {
    ?movie a :Movie ;
        :title ?title ;
        :releaseYear ?year ;
        rdfs:label "A Star Is Born (2018)" .
}

# FROM vs FROM NAMED

PREFIX : <urn:>
INSERT DATA {
    GRAPH :g1 {
        :a :knows :b, :d .
        :b :knows :c .
    }
    GRAPH :g2 {
        :d :knows :c .
    }
}

PREFIX : <urn:>
SELECT * FROM :g1 FROM :g2 {
    :a :knows ?mutual .
    ?mutual :knows :c .
}

PREFIX : <urn:>
SELECT * FROM NAMED :g1 FROM NAMED :g2 {
    GRAPH ?g {
        :a :knows ?mutual .
        ?mutual :knows :c .
    }
}

# Datasets and Virtual Graphs

PREFIX : <urn:>
SELECT * {
    GRAPH <virtual://datasets1_v1> {
        ?s a :Actor .
        ?s rdfs:label "Tom Hanks" .
    }
}

PREFIX : <urn:>
SELECT * {
    GRAPH <virtual://datasets2_v1> {
        ?s a :Actor .
        ?s rdfs:label "Tom Hanks" .
    }
}

PREFIX : <urn:>
SELECT * FROM NAMED <virtual://datasets1_v1> FROM NAMED <virtual://datasets2_v1> {
    GRAPH ?g {
        ?s a :Actor .
        ?s rdfs:label "Tom Hanks" .
    }
}

PREFIX : <urn:>
SELECT * FROM <virtual://datasets1_v1> FROM <virtual://datasets2_v1> {
    ?s a :Actor .
    ?s rdfs:label "Tom Hanks" .
}

# Unique Predicates, Revisited

PREFIX : <urn:>
SELECT * FROM <virtual://datasets1_v1> FROM <virtual://datasets2_v1> {
    :node:2 a ?type .
}

PREFIX : <urn:>
SELECT * FROM <virtual://datasets1_v2> FROM <virtual://datasets2_v2> {
    ?s a :Actor .
    ?s rdfs:label "Tom Hanks" .
}


